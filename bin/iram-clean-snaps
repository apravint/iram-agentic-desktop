#!/usr/bin/env bash
# IRAM OS - Clean Up Disabled Old Snap Revisions & Set Retention Policy
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    if command -v pkexec >/dev/null 2>&1 && [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
        exec pkexec "$0" "$@"
    else
        exec sudo "$0" "$@"
    fi
fi

echo "==> Setting snap retention policy to 2 (minimum allowed)..."
snap set system refresh.retain=2 || true

echo "==> Finding and removing disabled snap revisions..."
# Process line by line
snap list --all | awk '/disabled/{print $1, $3}' | while read -r name rev; do
    if [[ -n "$name" && -n "$rev" ]]; then
        echo "--> Removing $name (revision $rev)..."
        snap remove "$name" --revision="$rev" || true
    fi
done

echo "==> Snap cleanup complete! Disk space freed and unused loop devices unmounted."
